# Kickstart file for Zathras KVM guest unattended install
# Generated by kvm_create role

# Use text mode install
text

# Installation source from ISO
cdrom

# Language and keyboard
lang en_US.UTF-8
keyboard us

# Network configuration - DHCP
network --bootproto=dhcp --device=link --activate --onboot=yes

# Root password (disabled, SSH key only)
rootpw --lock

# SSH key for root access
#sshkey --username=root "{{ kvm_guest_pub_key }}"

# Firewall
firewall --enabled --ssh

# SELinux
selinux --enforcing

# Timezone
timezone UTC --utc

# Bootloader
bootloader --location=mbr --append="console=ttyS0,115200n8"

# Disk partitioning - clear all and autopart
clearpart --all --initlabel
autopart --type=lvm

# Packages
%packages
@core
openssh-server
nfs-utils
numactl

%end

# Post-install script
%post --log=/root/kickstart-post.log

# Enable and start sshd
systemctl enable sshd
systemctl start sshd

# Configure NFS mount for ISO
mkdir -p /iso_install
echo "10.26.8.118:/iso_install_host /iso_install nfs ro,x-systemd.automount 0 0" >> /etc/fstab
 
# Create yum repos pointing to ISO content
cat > /etc/yum.repos.d/iso-baseos.repo << 'BASEOS_EOF'
[iso-baseos]
name=ISO BaseOS
baseurl=file:///iso_install/BaseOS
enabled=1
gpgcheck=0
BASEOS_EOF

cat > /etc/yum.repos.d/iso-appstream.repo << 'APPSTREAM_EOF'
[iso-appstream]
name=ISO AppStream
baseurl=file:///iso_install/AppStream
enabled=1
gpgcheck=0
APPSTREAM_EOF

#setup root ssh keys
mkdir /root/.ssh && chmod 700 /root/.ssh
touch /root/.ssh/authorized_keys && chmod 600 /root/.ssh/authorized_keys

cat > /root/.ssh/authorized_keys <<EOF
ssh-rsa  malucius@m42-h33-000-r650.rdu3.labs.perfscale.redhat.com ssh-rsa  malucius@m42-h33-000-r650.rdu3.labs.perfscale.redhat.com
EOF




%end

reboot
